# Copy to `llm/.env` (gitignored) and fill in real values.
# The sidecar loads this file at startup; real shell variables win over it.

# DeepSeek API key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Langfuse project keys: Settings -> API Keys in your Langfuse project.
# Optional: with these unset, tracing is off and nothing is sent anywhere.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# EU cloud; US is us.cloud.langfuse.com; or your self-hosted URL.
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
