
// Back to game main

log("-------Returning to game main ----------")
loop(10) {
    if (button_cross_return.png)
        tap(button_cross_return.png)
    if (button_arrow_return.png)
        tap(button_arrow_return.png)

    if (anchor_main.png)
        break
}
log("-------Reached game main ---------------")

log("-------Returning to city main ----------")
if (button_expand_location.png)
    tap(button_expand_location.png)
else
    log("Cannot expand location!")

if (button_city_main.png)
    tap(button_city_main.png)
else
    log("Cannot find city main!")
log("------Reached city main ----------------")

log("------Entering city main ---------------")
if (button_enter_city.png)
    tap(button_enter_city.png)
else
    log("Cannot enter city main.")
log("------Entered city main ----------------")

log("------Inquiring Each team --------------")
tap_at(0.2024, 0.7743)
if (anchor_team_detail.png) {
    if (button_auto_assemble.png) {
        tap(button_auto_assemble.png)
    }
}
else {
    loop(5) {
        if (button_cross_return.png)
            tap(button_cross_return.png)
        if (button_arrow_return.png)
            tap(button_arrow_return.png)

        if (anchor_city_main.png)
            break
    }
}
log("------Completed each team --------------")

log("-------Returning to game main ----------")
loop(10) {
    if (button_cross_return.png)
        tap(button_cross_return.png)
    if (button_arrow_return.png)
        tap(button_arrow_return.png)

    if (anchor_main.png)
        break
}
log("-------Reached game main ---------------")
