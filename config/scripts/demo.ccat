// CampCat .ccat script. PNG paths are relative to this file's folder
// unless images_root is set in scripts/ccat_script.json.
//
// Statements:
//   tap(img);   tap_at(x, y);           // x,y normalized [0,1] vs screenshot size
//   swipe(img_from, img_to);           // one screenshot, swipe between match centers
//   swipe_at(x1,y1,x2,y2);             // normalized endpoints
//   wait(ms);   wait_until(img, ms);    // poll until template appears
//   log(msg);   if (img) { } else { }
//   retry(n) stmt_or_block;
//   loop(n) { }                       // run block exactly n times (n may be 0); use `break` to exit early
//   do { } while (img);                // repeat while template still matches (cap 50k iter); `break` exits
//   break;                             // exit innermost loop / do-while / retry


// Loop test
loop (5) {
    log("Break loop test")
    break
}