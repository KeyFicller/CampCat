{
  "adb": {
    "connect_address": "127.0.0.1:5555",
    "path": "/Applications/MuMuPlayer.app/Contents/MacOS/MuMuEmulator.app/Contents/MacOS/tools/adb",
    "serial": ""
  },
  "approval": {
    "gates": {
      "delete_script": true,
      "rename_script": true,
      "run_script": true,
      "save_script": true,
      "save_template": true,
      "tap": true,
      "update_script": true
    },
    "require": true
  },
  "input": {
    "action_gap_ms": 1000,
    "swipe_duration_ms": 300,
    "tap_delay_ms": 150
  },
  "match": {
    "debug": false,
    "debug_dir": "match_debug",
    "multiscale": false,
    "threshold": 0.7
  },
  "mumu": {
    "device_index": 0,
    "tool_path": "/Applications/MuMuPlayer.app/Contents/MacOS/mumutool"
  },
  "scheduler": {
    "enabled": true,
    "interval_seconds": 300,
    "jitter_seconds": 7,
    "skip_if_busy": false
  },
  "script": {
    "active_id": "ccat_script",
    "registry": [
      {
        "id": "ccat_script",
        "path": "scripts/ccat_script.json"
      }
    ]
  }
}
