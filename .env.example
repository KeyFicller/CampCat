# Copy to `.env` (gitignored) and fill in real values.
# The sidecar loads this file at startup; real shell variables win over it.

# Which provider to talk to: `deepseek` (default) or `qwen`. Normally chosen in
# the app's settings (the gear in the LLM panel); this is only the fallback for
# running the sidecar by hand.
#CAMPCAT_LLM_PROVIDER=deepseek

# One key and one base URL per provider. Both are passed to the client
# explicitly, so these names are ours rather than any integration's. A blank
# `*_BASE_URL` falls back to the default compiled into campcat/python/models.py.

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen, from Alibaba Cloud Model Studio (Bailian):
# https://bailian.console.aliyun.com -> API-KEY.
# The key and the base URL must match: a plan key (`sk-sp-`) only works against
# the plan endpoint below, while a pay-as-you-go key (`sk-`) needs
# https://dashscope.aliyuncs.com/compatible-mode/v1. Mixing them returns 401.
QWEN_API_KEY=sk-your-qwen-key
QWEN_BASE_URL=https://token-plan.maas.qianwenaiapi.com/compatible-mode/v1

# Langfuse project keys: Settings -> API Keys in your Langfuse project.
# Optional: with these unset, tracing is off and nothing is sent anywhere.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# EU cloud; US is us.cloud.langfuse.com; or your self-hosted URL.
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
